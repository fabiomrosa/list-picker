{
  "name": "list-picker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/vanilla",
    "packages/react"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run packed && npm run e2e",
    "dev": "vite playground",
    "bench": "node bench/run.ts",
    "trace": "node bench/drag-trace.ts",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.include='packages/*/src/**' --coverage.thresholds.lines=80",
    "e2e": "playwright test",
    "build": "npm run build --workspaces",
    "site": "vite site",
    "site:build": "vite build site && vite build playground --base /list-picker/demo/ --outDir ../dist-site/demo",
    "packed": "node scripts/check-packed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "fast-check": "4.11.0",
    "happy-dom": "21.0.4",
    "marked": "18.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
