{
  "name": "list-picker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run e2e",
    "dev": "vite playground",
    "bench": "node bench/run.ts",
    "trace": "node bench/drag-trace.ts",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.include='packages/*/src/**' --coverage.thresholds.lines=80",
    "e2e": "playwright test",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@vitest/coverage-v8": "5.1.1",
    "fast-check": "4.11.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
