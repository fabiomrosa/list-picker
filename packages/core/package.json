  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiomrosa/list-picker.git",
    "directory": "packages/core"
  },
  "keywords": [
    "kanban",
    "board",
    "linked-list",
    "list",
