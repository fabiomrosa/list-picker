{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@list-picker/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "playground",
    "bench",
    "e2e",
    "playwright.config.ts",
    "site"
  ]
}
